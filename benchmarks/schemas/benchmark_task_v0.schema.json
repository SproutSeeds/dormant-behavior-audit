{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/dormant-behavior-audit/benchmark_task_v0.schema.json",
  "title": "Benchmark Task V0",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "task_id",
    "task_name",
    "benchmark_role",
    "execution_expectation",
    "task_track",
    "task_status",
    "access_modes",
    "task_summary",
    "model_scope",
    "ground_truth",
    "protocol_artifacts",
    "scoring_dimensions",
    "reference_claims",
    "reference_bundle"
  ],
  "properties": {
    "schema_version": {
      "const": "benchmark_task_v0"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 3
    },
    "task_id": {
      "type": "string",
      "minLength": 3
    },
    "task_name": {
      "type": "string",
      "minLength": 3
    },
    "benchmark_role": {
      "type": "string",
      "enum": [
        "core_local_reference",
        "reference_case_supplement",
        "supplementary_reference"
      ]
    },
    "execution_expectation": {
      "type": "string",
      "enum": [
        "local_or_benchmark_owned",
        "historical_reference_api",
        "partner_approved_remote"
      ]
    },
    "task_track": {
      "type": "string",
      "enum": [
        "seeded_dormant_behavior",
        "naturalistic_audit",
        "mechanistic_corroboration"
      ]
    },
    "task_status": {
      "type": "string",
      "enum": [
        "reference_task",
        "candidate_task",
        "held_out_task"
      ]
    },
    "access_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "black_box",
          "open_weight",
          "open_weight_supporting",
          "hybrid"
        ]
      }
    },
    "task_summary": {
      "type": "string",
      "minLength": 20
    },
    "model_scope": {
      "type": "object"
    },
    "ground_truth": {
      "type": "object"
    },
    "starter_probe_plan": {
      "type": "object"
    },
    "protocol_artifacts": {
      "type": "object"
    },
    "scoring_dimensions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "text": {
            "type": "string",
            "minLength": 5
          }
        },
        "additionalProperties": true
      }
    },
    "reference_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "expected_stability",
          "evidence_paths"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "text": {
            "type": "string",
            "minLength": 10
          },
          "expected_stability": {
            "type": "string"
          },
          "evidence_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        },
        "additionalProperties": true
      }
    },
    "reference_bundle": {
      "type": "string",
      "minLength": 3
    }
  },
  "additionalProperties": true
}
