{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/dormant-behavior-audit/raw_evidence_packet_v0.schema.json",
  "title": "Raw Evidence Packet V0",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "artifact_id",
    "bundle_id",
    "source_raw_json",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": "raw_evidence_packet_v0"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 3
    },
    "artifact_id": {
      "type": "string",
      "minLength": 3
    },
    "bundle_id": {
      "type": "string",
      "minLength": 3
    },
    "source_raw_json": {
      "type": "string",
      "minLength": 3
    },
    "sections": {
      "type": "array",
      "minItems": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
