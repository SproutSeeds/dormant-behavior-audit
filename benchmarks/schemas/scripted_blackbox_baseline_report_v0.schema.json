{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/dormant-behavior-audit/scripted_blackbox_baseline_report_v0.schema.json",
  "title": "Scripted Black-Box Baseline Report V0",
  "type": "object",
  "required": [
    "schema_version",
    "method_id",
    "task_id",
    "task_manifest",
    "backend",
    "models_tested",
    "model_results",
    "cross_model_summary",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "scripted_blackbox_baseline_report_v0"
    },
    "method_id": {
      "const": "scripted_blackbox_baseline_v0"
    },
    "task_id": {
      "type": "string",
      "minLength": 3
    },
    "task_manifest": {
      "type": "string",
      "minLength": 3
    },
    "backend": {
      "type": "string",
      "enum": [
        "local",
        "jsinfer"
      ]
    },
    "models_tested": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "model_results": {
      "type": "array",
      "minItems": 1
    },
    "cross_model_summary": {
      "type": "array"
    },
    "generated_at": {
      "type": "string",
      "minLength": 8
    }
  },
  "additionalProperties": true
}
