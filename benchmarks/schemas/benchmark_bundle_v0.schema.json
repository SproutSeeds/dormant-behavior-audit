{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/dormant-behavior-audit/benchmark_bundle_v0.schema.json",
  "title": "Benchmark Bundle V0",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_name",
    "bundle_name",
    "bundle_role",
    "task_track",
    "access_modes",
    "summary",
    "artifacts",
    "claims",
    "metrics",
    "validation_reports",
    "launch_assets"
  ],
  "properties": {
    "schema_version": {
      "const": "benchmark_bundle_v0"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 3
    },
    "benchmark_name": {
      "type": "string",
      "minLength": 3
    },
    "bundle_name": {
      "type": "string",
      "minLength": 3
    },
    "bundle_role": {
      "type": "string",
      "enum": [
        "reference_bundle",
        "baseline_submission",
        "external_submission",
        "ablation_bundle"
      ]
    },
    "task_track": {
      "type": "string",
      "enum": [
        "seeded_dormant_behavior",
        "naturalistic_audit",
        "mechanistic_corroboration"
      ]
    },
    "access_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "black_box",
          "open_weight",
          "open_weight_supporting",
          "hybrid"
        ]
      }
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "artifacts": {
      "type": "object",
      "required": [
        "main_report_md",
        "packet_index",
        "stats_appendix",
        "raw_evidence_appendix",
        "packet_self_check"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "evidence_bundles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "claim_type",
          "expected_stability",
          "evidence_paths"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "text": {
            "type": "string",
            "minLength": 10
          },
          "claim_type": {
            "type": "string"
          },
          "expected_stability": {
            "type": "string"
          },
          "evidence_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        },
        "additionalProperties": true
      }
    },
    "metrics": {
      "type": "object"
    },
    "validation_reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "launch_assets": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
